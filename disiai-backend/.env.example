# --- DISIAI backend (copy to .env and adjust) ---
APP_NAME=DISIAI
ENV=local
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Text & context extraction: Qwen 2.5 via local Ollama (OpenAI-compatible)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_API_KEY=ollama
EXTRACTOR_MODEL=qwen2.5:3b-instruct
EXTRACTOR_USE_LLM=true
LLM_TIMEOUT_SECONDS=30

# Local state
SQLITE_PATH=./disiai.db

# Voice input: Faster-Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Voice output: Edge-TTS (Bahasa Indonesia)
TTS_VOICE=id-ID-GadisNeural
TTS_RATE=+0%

# Avatar: SadTalker or local mock fallback
SADTALKER_ENABLED=false
SADTALKER_BIN=
SADTALKER_CKPT=
AVATAR_IMAGE_PATH=./static/mock/avatar.png
MOCK_VIDEO_PATH=./static/mock/avatar.mp4

LOG_LEVEL=INFO
